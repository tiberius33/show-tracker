rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Concert photos/videos — see lib/photos.js. Path shape:
    //   showPhotos/{concertKey}/{uid}/{fileName}
    // Read requires auth (matches the showPhotos Firestore rule — anyone
    // signed in who's logged the concert can view). Write is limited to
    // the uploader's own uid segment, capped at 10MB, and restricted to
    // images or MP4 video — kept in sync with lib/photos.js's
    // ALLOWED_TYPES/MAX_FILE_BYTES. Delete additionally allows the admin
    // account (kept in sync with ADMIN_EMAILS in lib/constants.js), for
    // moderation of a file whose Firestore doc was deleted by an admin.
    match /showPhotos/{concertKey}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'video/mp4');
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.email == 'phillip.leonard@gmail.com');
    }
  }
}
